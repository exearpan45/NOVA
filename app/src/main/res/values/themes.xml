<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Nova" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Native Splash Screen theme adhering to official Android SplashScreen API -->
    <style name="Theme.Nova.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0F19</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nova_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Nova</item>
    </style>
</resources>

